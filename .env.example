# The navigator uses the Claude Agent SDK, which picks up your Claude Code login.
# Set this only to use an API key instead.
# ANTHROPIC_API_KEY=

# Optional. Model and reasoning effort for the navigator.
# CODEFLIGHT_MODEL=claude-opus-5-5
# CODEFLIGHT_EFFORT=medium
# CODEFLIGHT_INTRO_EFFORT=medium
# CODEFLIGHT_STORY_EFFORT=medium

# Optional. The voice, and narration for stories (without it they play silently,
# with captions). Everything else works without it. Already base64; paste as-is.
INWORLD_API_KEY=

# Optional. Realtime model behind the voice; it must support function tools.
# INWORLD_REALTIME_MODEL=openai/gpt-5.6-luna

# Optional. Open this repo on start (same as `npm run dev -- <path>`).
# CODEFLIGHT_REPO=
# PORT=4317

# Optional. Where repo sessions are saved (default: .cache/ here). Point a second
# server at a different directory to run it on the same repo without touching
# the first one's saved state.
# CODEFLIGHT_CACHE_DIR=

# Optional. Path to gopls, if it isn't on PATH or in $(go env GOPATH)/bin.
# GOPLS=

# Optional. How often to fetch the branch's upstream and offer new commits, in
# seconds (default 300; 0 turns it off).
# CODEFLIGHT_FETCH_SECONDS=300

# Optional. How long after new files show up, in seconds, the navigator places
# them in the modules and your groupings (default 20; 0 turns it off), and how
# hard it thinks about it.
# CODEFLIGHT_PLACE_SECONDS=20
# CODEFLIGHT_PLACE_EFFORT=low

# Optional. Pin the server to the repo it started with (the container sets this).
# CODEFLIGHT_LOCK_REPO=1

# Optional. Open GitHub repos instead of local paths: each is cloned into this
# folder on request, and the ones opened before are kept, with their maps.
# CODEFLIGHT_REPOS_DIR=

# Optional. Coding agents (Agents, or "change this" to the voice), each in its own git
# worktree on its own branch. On by default; 0 turns them off. They can read and edit
# only inside their worktree. Bash lets them run tests and builds, but also anything else
# the server's user can, so leave it off on a shared box.
# CONSTELLATE_AGENTS=1
# CONSTELLATE_AGENT_BASH=0
# CONSTELLATE_AGENT_LIMIT=3
# CONSTELLATE_AGENT_MODEL=claude-opus-5-5
# CONSTELLATE_AGENT_EFFORT=high
